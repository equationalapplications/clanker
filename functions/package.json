{
  "name": "functions",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf lib && tsc",
    "build:int": "rm -rf lib-integration && tsc -p tsconfig.int.json",
    "typecheck:int": "tsc -p tsconfig.int.json --noEmit",
    "test:integration": "npm run build:int && node --test --test-concurrency=1 --test-reporter spec \"lib-integration/**/*.test.js\"",
    "test": "NODE_ENV=test npm run build && NODE_ENV=test node --test --test-reporter spec \"lib/**/*.test.js\" \"scripts/**/*.test.mjs\"",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions -P clanker-prod",
    "logs": "firebase functions:log",
    "migrate": "node scripts/migrate.mjs",
    "migrate:dev": "node scripts/migrate-dev.mjs",
    "backup:db": "bash scripts/backup-db.sh",
    "deploy:migrations": "bash scripts/deploy-migrations.sh"
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "type": "module",
  "dependencies": {
    "@equationalapplications/core-llm-tools": "^7.1.0",
    "@google-cloud/cloud-sql-connector": "^1.12.0",
    "@google/adk": "^2.0.0",
    "@google/genai": "^2.21.0",
    "drizzle-orm": "^0.45.2",
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.2.5",
    "mammoth": "^1.12.0",
    "pg": "^8.20.0",
    "stripe": "^22.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "~24.13.3",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "firebase-tools": "^15.29.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "adm-zip": "^0.6.0",
    "js-yaml": "^4.3.2",
    "@opentelemetry/core": "^2.8.0",
    "@tootallnate/once": "^2.0.1",
    "sqlite3": {
      "tar": "7.5.22"
    },
    "mysql2": "^3.24.3",
    "mariadb": "^3.5.4",
    "fast-uri": "^3.1.7",
    "qs": "^6.16.0"
  },
  "private": true
}
