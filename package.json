{
  "name": "clanker",
  "version": "32.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "build:prod-a": "node scripts/eas-local-build.js --platform android --profile production",
    "build:dev-a": "node scripts/eas-local-build.js --platform android --profile development",
    "build:prod-i": "node scripts/eas-local-build.js --platform ios --profile production",
    "build:dev-i": "node scripts/eas-local-build.js --platform ios --profile development",
    "build:dev-sim": "node scripts/eas-local-build.js --platform ios --profile development-simulator",
    "start": "expo start --dev-client",
    "start:clear": "expo start --dev-client -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:clear": "expo start --web -c",
    "web:tunnel": "expo start --web --tunnel",
    "devtools": "react-devtools",
    "release": "semantic-release",
    "postinstall": "patch-package --error-on-fail",
    "prepare": "husky install",
    "commit": "git-cz",
    "format": "prettier --write \"**/*.{js,jsx,json,md,ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,json,md,ts,tsx}\"",
    "lint": "npx expo lint --fix",
    "lint:check": "npx expo lint --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:generate": "npx expo export --platform web --clear && npm run typecheck",
    "test": "node -e \"const p=require('path');process.env.NODE_OPTIONS=(process.env.NODE_OPTIONS?process.env.NODE_OPTIONS+' ':'')+('--require '+p.resolve('./jest.preload.cjs'));const{spawnSync}=require('child_process');const r=spawnSync(process.platform==='win32'?'jest.cmd':'jest',process.argv.slice(2),{stdio:'inherit',env:process.env});process.exit(r.status??0);\" --",
    "test:watch": "node -e \"const p=require('path');process.env.NODE_OPTIONS=(process.env.NODE_OPTIONS?process.env.NODE_OPTIONS+' ':'')+('--require '+p.resolve('./jest.preload.cjs'));const{spawnSync}=require('child_process');const r=spawnSync(process.platform==='win32'?'jest.cmd':'jest',['--watch',...process.argv.slice(2)],{stdio:'inherit',env:process.env});process.exit(r.status??0);\" --",
    "edge-evals": "node -e \"const p=require('path');process.env.NODE_OPTIONS=(process.env.NODE_OPTIONS?process.env.NODE_OPTIONS+' ':'')+('--require '+p.resolve('./jest.preload.cjs'));const{spawnSync}=require('child_process');const r=spawnSync(process.platform==='win32'?'jest.cmd':'jest',['--config','jest.evals.config.js','--runInBand',...process.argv.slice(2)],{stdio:'inherit',env:process.env});process.exit(r.status??0);\" --",
    "docs:charts": "node scripts/generate-charts.js",
    "generate:static-pages": "node scripts/generate-static-pages.js",
    "adb": "adb reverse tcp:8081 tcp:8081",
    "predeploy": "node scripts/check-web-export-env.mjs && npm run generate:static-pages && npx expo export --platform web --clear",
    "deploy-hosting": "npm run predeploy && firebase deploy --only hosting",
    "preota": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "ota": "node -e \"const { spawnSync } = require('child_process'); const easBranch = process.argv[2] || 'production'; const cmd = process.platform === 'win32' ? 'npx.cmd' : 'npx'; const result = spawnSync(cmd, ['--yes', 'eas-cli', 'update', '--auto', '--non-interactive', '--branch', easBranch, '--message', 'OTA update', '--environment', 'production', '--clear-cache'], { stdio: 'inherit' }); process.exit(result.status ?? 1);\" --",
    "update": "npm run deploy-hosting && npm run ota"
  },
  "dependencies": {
    "@equationalapplications/core-llm-tools": "^5.5.1",
    "@equationalapplications/core-llm-wiki": "^5.2.1",
    "@equationalapplications/expo-llm-wiki": "^5.5.1",
    "@equationalapplications/schema-org-llm-wiki": "^5.5.1",
    "@expo/metro-runtime": "~57.0.9",
    "@expo/vector-icons": "^15.1.1",
    "@google/genai": "^2.19.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-firebase/analytics": "^26.3.2",
    "@react-native-firebase/app": "^26.3.2",
    "@react-native-firebase/app-check": "^26.3.2",
    "@react-native-firebase/auth": "^26.3.2",
    "@react-native-firebase/crashlytics": "^26.3.2",
    "@react-native-firebase/functions": "^26.3.2",
    "@react-native-firebase/storage": "^26.3.2",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@speechmatics/expo-two-way-audio": "0.1.2",
    "@tanstack/react-query": "^5.102.4",
    "@tanstack/react-query-persist-client": "^5.102.4",
    "@xstate/react": "^6.1.0",
    "dotenv": "^17.4.2",
    "expo": "~57.0.17",
    "expo-age-range": "^57.0.4",
    "expo-apple-authentication": "~57.0.1",
    "expo-asset": "~57.0.10",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.15",
    "expo-constants": "~57.0.10",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.16",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.2",
    "expo-image-manipulator": "~57.0.14",
    "expo-image-picker": "~57.0.14",
    "expo-linking": "~57.0.8",
    "expo-media-library": "~57.0.3",
    "expo-notifications": "~57.0.15",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-sharing": "~57.0.16",
    "expo-splash-screen": "~57.0.6",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-task-manager": "~57.0.14",
    "expo-updates": "~57.0.18",
    "firebase": "^12.18.0",
    "jszip": "^3.10.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-error-boundary": "^3.1.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-paper": "^5.15.3",
    "react-native-purchases": "^10.8.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "wa-sqlite": "^1.0.0",
    "xstate": "^5.32.6",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/eslintrc": "^3.3.6",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^13.1.5",
    "@testing-library/react": "^16.3.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "~24.13.3",
    "@types/react": "~19.2.14",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "better-sqlite3": "^13.0.3",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.4",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.6",
    "react-test-renderer": "19.2.3",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.9",
    "semantic-release-react-native": "^1.12.2",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "license": "MIT",
  "expo": {
    "router": {
      "origin": "expo"
    }
  },
  "prettier": {
    "printWidth": 100,
    "semi": false,
    "singleQuote": true,
    "trailingComma": "all",
    "tabWidth": 2
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  }
}
