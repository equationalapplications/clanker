{
  "name": "clanker-cloud-agent",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/cloud-agent/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test npm run build && NODE_ENV=test node --test --test-reporter spec \"dist/**/*.test.js\"",
    "test:live": "RUN_LIVE_TESTS=1 npm test",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@equationalapplications/core-llm-tools": "^5.2.1",
    "@equationalapplications/core-llm-wiki": "^5.2.1",
    "@google-cloud/cloud-sql-connector": "^1.10.0",
    "@google/adk": "^2.0.0",
    "@google/genai": "^2.16.0",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "firebase-admin": "^14.2.0",
    "pg": "^8.20.0",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "~24.13.3",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "supertest": "^7.0.0",
    "tsx": "^4.9.3",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "adm-zip": "^0.6.0",
    "@opentelemetry/core": "^2.8.0",
    "@tootallnate/once": "^2.0.1",
    "sqlite3": {
      "tar": "7.5.22"
    }
  }
}
